{
	"name": "obsidian-webpage-export",
	"version": "1.3.2",
	"description": "Exports an obsidian document as an HTML document / webpage / website, correctly including all styling and formatting.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"typecheck": "tsc --noEmit -p tsconfig.json --skipLibCheck && tsc --noEmit -p tsconfig.strict.json",
		"lint": "eslint src/core tests tools vitest.config.ts --no-error-on-unmatched-pattern --max-warnings 0 && prettier --check src/core tests tools vitest.config.ts && vite-node tools/lint/run.ts",
		"test": "vitest run tests/unit tests/tooling",
		"gate": "vite-node tools/gate/run.ts",
		"gate:release": "vite-node tools/gate/run.ts --release",
		"fixtures": "node tests/fixtures/generate.ts",
		"fixtures:plugins": "vite-node tools/fixtures/fetch.ts",
		"test:integration": "vitest run tests/integration"
	},
	"keywords": [],
	"author": "Nathan George",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.1.1",
		"@types/mime": "^3.0.4",
		"@types/node": "20.19.9",
		"@types/postcss-safe-parser": "^5.0.4",
		"@types/rss": "^0.0.32",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"electron": "^26.6.10",
		"esbuild": "0.14.47",
		"eslint": "^8.57.0",
		"globals": "^15.0.0",
		"obsidian": "^1.4.11",
		"obsidian-dataview": "^0.5.64",
		"prettier": "3.9.10",
		"tslib": "2.4.0",
		"typescript": "4.7.4",
		"typescript-eslint": "^7.7.0",
		"vitest": "3.2.7"
	},
	"dependencies": {
		"file-type": "^19.0.0",
		"html-minifier-terser": "^7.2.0",
		"mime": "^3.0.0",
		"minisearch": "^7.1.0",
		"postcss": "8.4.47",
		"postcss-safe-parser": "^7.0.0",
		"rss": "^1.2.2",
		"upath": "^2.0.1"
	}
}
